#!/bin/bash -e

load_secret() {
  local variable_name="$1"
  local secret_file="$2"

  if [ ! -r "$secret_file" ]; then
    echo "Required secret file for $variable_name is unavailable: $secret_file" >&2
    exit 1
  fi

  local secret_value
  secret_value="$(cat "$secret_file")"
  if [ -z "$secret_value" ]; then
    echo "Required secret file for $variable_name is empty: $secret_file" >&2
    exit 1
  fi

  export "$variable_name=$secret_value"
}

if [ "${RAILS_ENV:-production}" = "production" ]; then
  load_secret "RAILS_MASTER_KEY" "${RAILS_MASTER_KEY_FILE:-/run/secrets/rails_master_key}"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"

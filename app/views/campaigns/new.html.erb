<% content_for :title, "Create campaign" %>

<section class="campaign-creation" aria-labelledby="campaign-creation-heading">
  <h1 id="campaign-creation-heading">Create campaign</h1>
  <p>Give your campaign a name to add it to your catalog.</p>

  <% if @campaign.errors.any? %>
    <section class="form-errors" aria-labelledby="error-summary-heading" role="alert" tabindex="-1">
      <h2 id="error-summary-heading">There was a problem creating your campaign</h2>
      <ul>
        <% @campaign.errors.full_messages.each do |message| %>
          <li><a href="#campaign_name"><%= message %></a></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form_with model: @campaign, class: "campaign-form", html: { novalidate: true } do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name,
                          autofocus: true,
                          required: true,
                          maxlength: 128,
                          aria: {
                            describedby: @campaign.errors[:name].any? ? "campaign-name-error campaign-name-hint" : "campaign-name-hint",
                            invalid: @campaign.errors[:name].any?
                          } %>
      <p id="campaign-name-hint" class="field-hint">Use between 3 and 128 characters.</p>
      <% if @campaign.errors[:name].any? %>
        <p id="campaign-name-error" class="field-error"><%= @campaign.errors[:name].first %></p>
      <% end %>
    </div>

    <%= form.submit "Create campaign" %>
  <% end %>
</section>

<% content_for :title, "Campaign Catalog" %>

<section class="campaign-catalog" aria-labelledby="campaign-catalog-heading">
  <h1 id="campaign-catalog-heading">Campaign Catalog</h1>

  <% if flash[:notice].present? %>
    <p class="success-message" role="status"><%= flash[:notice] %></p>
  <% end %>

  <%= link_to "Create Campaign", new_campaign_path, class: "create-campaign-button" %>

  <table>
    <thead>
      <tr>
        <th scope="col">Name</th>
      </tr>
    </thead>
    <tbody>
      <% if @campaigns.empty? %>
        <tr>
          <td>no campaigns yet!</td>
        </tr>
      <% else %>
        <% @campaigns.each do |campaign| %>
          <tr>
            <td><%= campaign.name %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</section>

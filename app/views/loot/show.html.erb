<% content_for :title, "Loot Generator" %>

<article class="loot-generator" data-controller="loot">
  <h1>Loot Generator</h1>

  <section class="individual-treasure" aria-labelledby="individual-treasure-heading">
    <h2 id="individual-treasure-heading">Individual Treasure</h2>

    <form class="loot-controls" data-action="submit->loot#generate">
      <div class="loot-field">
        <label for="monster-cr">Monster CR</label>
        <select id="monster-cr" name="monster_cr" data-loot-target="challengeRating" data-action="change->loot#updateButton">
          <option value="" selected>Select a CR</option>
          <% [ "1/8", "1/4", "1/2", *1..16, "17+" ].each do |challenge_rating| %>
            <option value="<%= challenge_rating %>"><%= challenge_rating %></option>
          <% end %>
        </select>
      </div>

      <button type="submit" class="loot-generate-button" disabled data-loot-target="generateButton">Generate</button>
    </form>

    <div class="loot-results" role="status" aria-live="polite" aria-atomic="true" data-loot-target="results"></div>
    <p class="sr-only" role="status" data-loot-target="copyStatus"></p>
  </section>

  <hr>

  <section class="treasure-horde" aria-labelledby="treasure-horde-heading">
    <h2 id="treasure-horde-heading">Treasure Horde</h2>
  </section>
</article>
